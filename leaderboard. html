<!DOCTYPE html>
<html lang="bn">
<head>

<meta charset="UTF-8">

<meta name="viewport"
content="width=device-width, initial-scale=1.0">

<title>SB Tournament - Leaderboard</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}

body{
    background:#080d1c;
    color:white;
}

/* Header */

header{
    background:#111936;
    padding:20px;
    text-align:center;
}

header h1{
    color:#00e5ff;
    font-size:26px;
}

header p{
    color:#aaa;
    margin-top:6px;
}

/* Container */

.container{
    width:94%;
    max-width:850px;
    margin:25px auto;
}

/* Title */

.title{
    text-align:center;
    color:#00e5ff;
    margin-bottom:20px;
}

/* Top Players */

.top-players{
    display:grid;
    grid-template-columns:
    repeat(auto-fit,minmax(180px,1fr));
    gap:15px;
    margin-bottom:25px;
}

.top-card{
    background:#121a35;
    border:1px solid #25315b;
    border-radius:15px;
    padding:20px;
    text-align:center;
}

.top-card .rank{
    font-size:35px;
    margin-bottom:8px;
}

.top-card h3{
    color:#00e5ff;
    margin-bottom:8px;
}

.top-card p{
    color:#aaa;
}

/* Leaderboard */

.board{
    background:#121a35;
    border:1px solid #25315b;
    border-radius:15px;
    padding:18px;
    overflow:hidden;
}

.board-title{
    color:#00e5ff;
    margin-bottom:15px;
}

/* Table */

.table-wrapper{
    width:100%;
    overflow-x:auto;
}

table{
    width:100%;
    border-collapse:collapse;
    min-width:650px;
}

th{
    background:#1b2545;
    color:#00e5ff;
    padding:13px;
    text-align:left;
}

td{
    padding:13px;
    border-bottom:1px solid #273252;
    color:#ddd;
}

tr:hover{
    background:#18213e;
}

/* Rank */

.rank-number{
    font-weight:bold;
}

.gold{
    color:#ffd700;
}

.silver{
    color:#c0c0c0;
}

.bronze{
    color:#cd7f32;
}

/* Points */

.points{
    color:#5cff9a;
    font-weight:bold;
}

/* Buttons */

.buttons{
    margin-top:20px;
}

.btn{
    display:block;
    width:100%;
    padding:13px;
    margin-top:10px;
    border-radius:9px;
    text-align:center;
    text-decoration:none;
    font-weight:bold;
}

.primary{
    background:#00e5ff;
    color:#061018;
}

.secondary{
    background:#252e4d;
    color:white;
}

/* Footer */

footer{
    margin-top:35px;
    padding:20px;
    background:#111936;
    text-align:center;
    color:#777;
}

</style>

</head>


<body>


<header>

    <h1>🏆 SB TOURNAMENT</h1>

    <p>Leaderboard & Ranking</p>

</header>


<div class="container">


<h2 class="title">
    🔥 Top Players
</h2>


<!-- TOP 3 -->

<div class="top-players">


    <div class="top-card">

        <div class="rank">
            🥇
        </div>

        <h3>
            Shadow King
        </h3>

        <p>
            ⭐ 125 Points
        </p>

    </div>


    <div class="top-card">

        <div class="rank">
            🥈
        </div>

        <h3>
            RX Rafi
        </h3>

        <p>
            ⭐ 110 Points
        </p>

    </div>


    <div class="top-card">

        <div class="rank">
            🥉
        </div>

        <h3>
            SBT Killer
        </h3>

        <p>
            ⭐ 98 Points
        </p>

    </div>

</div>


<!-- LEADERBOARD -->

<div class="board">

    <h2 class="board-title">
        📊 Player Ranking
    </h2>


    <div class="table-wrapper">

    <table>

        <thead>

            <tr>

                <th>
                    Rank
                </th>

                <th>
                    Player
                </th>

                <th>
                    UID
                </th>

                <th>
                    Wins
                </th>

                <th>
                    Points
                </th>

            </tr>

        </thead>


        <tbody id="leaderboard">

        </tbody>

    </table>

    </div>

</div>


<!-- BUTTONS -->

<div class="buttons">

    <a
        href="tournaments.html"
        class="btn primary">

        🎮 View Tournaments

    </a>


    <a
        href="dashboard.html"
        class="btn secondary">

        👤 My Dashboard

    </a>


    <a
        href="index.html"
        class="btn secondary">

        🏠 Home

    </a>

</div>


</div>


<footer>

    © 2026 SB Tournament

</footer>


<script>

/*
    Demo Leaderboard Data

    পরে P6/P7-এ আমরা
    Admin Panel + Database
    যোগ করলে এগুলো
    automatically update করা যাবে।
*/


const players = [

    {
        name:"Shadow King",
        uid:"100001",
        wins:12,
        points:125
    },

    {
        name:"RX Rafi",
        uid:"100002",
        wins:10,
        points:110
    },

    {
        name:"SBT Killer",
        uid:"100003",
        wins:9,
        points:98
    },

    {
        name:"Dark FF",
        uid:"100004",
        wins:8,
        points:90
    },

    {
        name:"Legend BD",
        uid:"100005",
        wins:7,
        points:82
    },

    {
        name:"Fire King",
        uid:"100006",
        wins:6,
        points:75
    },

    {
        name:"RDX Player",
        uid:"100007",
        wins:5,
        points:68
    },

    {
        name:"SBT Pro",
        uid:"100008",
        wins:4,
        points:60
    }

];


/* Sort by Points */

players.sort(function(a,b){

    return b.points - a.points;

});


/* Create Rows */

const leaderboard =
    document.getElementById(
        "leaderboard"
    );


players.forEach(function(player,index){

    const row =
        document.createElement("tr");


    let rankClass =
        "rank-number";


    if(index === 0){

        rankClass += " gold";

    }

    else if(index === 1){

        rankClass += " silver";

    }

    else if(index === 2){

        rankClass += " bronze";

    }


    row.innerHTML =

        "<td class='" +
        rankClass +
        "'>" +

        "#" +
        (index + 1) +

        "</td>" +


        "<td>" +

        "🎮 " +
        player.name +

        "</td>" +


        "<td>" +

        player.uid +

        "</td>" +


        "<td>" +

        "🏆 " +
        player.wins +

        "</td>" +


        "<td class='points'>" +

        player.points +

        "</td>";


    leaderboard.appendChild(row);

});


</script>


</body>
</html>
